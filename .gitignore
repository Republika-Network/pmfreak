# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# AOC workspace package build artifacts (rebuilt via `npm run build:aoc`)
/src/aoc/protocol/dist/
/src/aoc/enterprise/dist/

# Beta release gate per-run logs (scripts/check-beta-release.mjs)
/.beta-release-logs/

# Fresh DB migration proof per-run logs (scripts/check-fresh-db-migrations.mjs)
/.fresh-db-migration-logs/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.operational-flow.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local uploaded files
uploads/
.claude/

# P2-14 browser acceptance artifacts (screenshots, report, Playwright output).
# Regenerated by `npm run test:e2e:p2-14`; never committed, and never carries a secret.
/artifacts/p2-14/
# P2-16 schedule exposure browser screenshots (tests/e2e/p2-16-schedule-exposure.spec.ts).
/artifacts/p2-16/
# P2-17 PMO attention browser screenshots (tests/e2e/p2-17-pmo-attention.spec.ts).
/artifacts/p2-17/
# PB-CHAT-01 Project Brain browser screenshots (tests/e2e/pb-chat-01-project-brain.spec.ts).
/artifacts/pb-chat-01/
/test-results/
/playwright-report/
/.playwright/

# RR-BACKUP local logical-backup artifacts (P0-LAUNCH-06 restore rehearsal).
# Contain full database schema + data dumps; NEVER committed.
/.rr-backup-artifacts/

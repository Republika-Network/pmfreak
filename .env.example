# ──────────────────────────────────────────────────────────────────────────
# PMFreak environment variables.
#
# See docs/security/production-deployment-boundary.md for the full
# public-vs-server-only contract this file mirrors, and
# src/lib/security/deployment-boundary-registry.ts for the enforced
# allowlists (tests/production-deployment-boundary.test.mjs fails CI if a
# NEXT_PUBLIC_* var is added here or in src/** without also being added to
# that registry).
#
# Rule of thumb: NEXT_PUBLIC_* is bundled into client JS and visible to
# anyone — never put a secret, key, or token behind that prefix. Everything
# else below is server-only and must never be read from a "use client" file.
# ──────────────────────────────────────────────────────────────────────────

# ── AI (server-only) ────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MESSAGE_NUDGES_MODEL=gpt-4.1-mini
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4.1-mini

# ── AI runtime guardrails (server-only, optional — Perilla 11) ───────────────
# All optional with conservative defaults; unparsable or out-of-range values
# fall back to the defaults (see src/lib/ai/runtime-limits.ts — bounds can
# never be disabled via env). AI_MAX_RETRIES counts retries after the first
# attempt.
AI_REQUEST_TIMEOUT_MS=25000
AI_MAX_RETRIES=2
AI_MAX_CHAIN_DEPTH=3
AI_MAX_CONCURRENT_PER_WORKSPACE=4
AI_DAILY_REQUEST_LIMIT=500
AI_DAILY_COST_LIMIT_USD=25

# ── Observability (server-only, optional — Perilla 11) ───────────────────────
# debug | info | warn | error (default info). Unknown values fall back to info.
LOG_LEVEL=info
# /api/ready database-reachability timeout in ms (default 3000, range 100–30000).
HEALTHCHECK_DATABASE_TIMEOUT_MS=3000

# ── Workspace invitations (server-only, optional — Perilla 11) ────────────────
# Invite lifetime in hours (default 168 = 7 days, range 1–720).
INVITE_TOKEN_TTL_HOURS=168

# ── Spreadsheet processing limits (server-only, optional — Perilla 12) ───────
# Bounds applied to every untrusted workbook parse (evidence uploads). All
# optional with conservative defaults; unparsable or out-of-range values fall
# back to the defaults (see src/lib/spreadsheets/limits.ts — bounds can never
# be disabled via env). Policy: docs/security/spreadsheet-processing-boundary.md.
SPREADSHEET_MAX_FILE_BYTES=10485760
SPREADSHEET_MAX_SHEETS=20
SPREADSHEET_MAX_ROWS_PER_SHEET=10000
SPREADSHEET_MAX_COLUMNS=256
SPREADSHEET_MAX_CELL_LENGTH=8192
SPREADSHEET_MAX_DECOMPRESSED_BYTES=104857600
SPREADSHEET_PARSE_TIMEOUT_MS=10000

# ── Supabase (required in production) ───────────────────────────────────────
# Public: safe to expose. RLS (Perilla 7), not secrecy of these values, is
# what protects data — see docs/security/supabase-rls-service-role-boundary.md.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only. Bypasses RLS entirely — never expose to a client, never log
# unredacted, never put behind a NEXT_PUBLIC_ name. Missing in production
# fails closed (createPrivilegedSupabaseClient throws) rather than falling
# back to the anon key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Hosted Supabase fresh-DB migration proof (RR-MIGRATE, Perilla 13/13B) ───
# Only used by `npm run check:fresh-db-migrations` in hosted mode. Never set
# these against a production/pilot/staging project — see the safety guard in
# scripts/check-fresh-db-migrations.mjs and the honesty statement in
# docs/release/hosted-supabase-migration-proof.md. Names only below; no real
# values belong in this file.
SUPABASE_PROJECT_REF=your_isolated_test_project_ref
FRESH_DB_EXPECTED_PROJECT_REF=your_isolated_test_project_ref
SUPABASE_ACCESS_TOKEN=your_supabase_cli_personal_access_token
SUPABASE_DB_URL=postgresql://postgres:password@db.your-ref.supabase.co:5432/postgres
ALLOW_DESTRUCTIVE_FRESH_DB_TEST=false
# Local-mode alternative to the three hosted vars above (see
# database-bootstrap-runbook.md §1 "Local Postgres").
FRESH_DB_URL=postgresql://postgres:password@localhost:5432/pmfreak_fresh
# Real Supabase Auth users on the isolated test project, for the E.2/E.3
# hosted RLS role-matrix run (docs/release/hosted-rls-role-matrix.md).
# Never real credentials — throwaway accounts on the isolated project only.
SUPABASE_TEST_USER_A_EMAIL=test-user-a@example.invalid
SUPABASE_TEST_USER_A_PASSWORD=your_test_user_a_password
SUPABASE_TEST_USER_B_EMAIL=test-user-b@example.invalid
SUPABASE_TEST_USER_B_PASSWORD=your_test_user_b_password

# ── App base URL (required in production) ───────────────────────────────────
# Public. Canonical origin used for invite-email links and as the allowlisted
# redirect/CORS origin (src/lib/security/origin-policy.ts). Must be a real
# https URL in production — localhost here in production is a hard failure
# (see environment.ts assertProductionEnvSafety).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public. Legacy alias for the same app base URL, consumed only by the
# Supabase signUp emailRedirectTo call (src/app/signup/actions.ts). Keep in
# sync with NEXT_PUBLIC_APP_URL — see known residual risks in the doc above.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Founder / internal access (server-only, optional) ───────────────────────
# Comma-separated list of emails granted founder/internal access in addition to
# the @pmfreak.ai / @onchainfest.xyz internal domains (see src/lib/auth.ts).
# Server-side only — never sourced from user input or user_metadata. Leaving
# this empty is safe (no extra grants) — it is not a fail-open condition.
FOUNDER_EMAIL_ALLOWLIST=

# ── Stripe billing (server secrets required in production) ─────────────────
# Server-only. Full Stripe account access if leaked.
STRIPE_SECRET_KEY=sk_test_...
# Public. Designed to be exposed to Stripe.js.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Server-only. Webhook route fails closed (400) if this is missing — see
# docs/security/stripe-webhook-billing-lifecycle-boundary.md.
STRIPE_WEBHOOK_SECRET=whsec_...
# Server-only (not secret, but must stay server-sourced — a client-suppliable
# price id would let a user choose their own plan price).
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PMO_PRICE_ID=price_...

# ── Federation webhook ingestion (server-only, optional) ────────────────────
# Shared secret authorizing inbound federation connector events
# (src/app/api/federation/webhooks/[connectorId]/route.ts). Missing = all
# inbound events treated as unauthorized (fails closed).
FEDERATION_WEBHOOK_SECRET=

# ── AOC governance / trust signing (server-only) ────────────────────────────
# Governance capability switch (M-03). "true" exposes governance claim
# signing (approvals → issueExecutionGrant → createCapabilityClaim) and makes
# PMFREAK_CAPABILITY_CLAIM_SECRET REQUIRED at readiness (/api/ready fails
# without it). Unset/false = governance signing degrades gracefully with an
# explicit governance_capability_disabled error (fail-closed, never silent).
# Default for the closed pilot: disabled (see docs/release/pilot-capability-set.md).
PMFREAK_GOVERNANCE_CAPABILITY_ENABLED=
# Pilot capability profile (Task 7). "founder" shows every surface to every
# user of this deployment; unset/anything else = curated pilot profile for
# non-founder accounts (founder/internal users always get the full surface).
PMFREAK_CAPABILITY_PROFILE=
PMFREAK_TRUST_EVENT_HMAC_SECRET=
# Required when PMFREAK_GOVERNANCE_CAPABILITY_ENABLED=true; optional otherwise.
PMFREAK_CAPABILITY_CLAIM_SECRET=
PMFREAK_AGENT_TOKEN_SECRET=

# ── Founder Circle Program (server-only, optional — Founder Circle Sprint 01) ─
# All flags default OFF; only the literal string "true" enables (fail-closed —
# see src/lib/founder-program/config.ts). Enablement additionally requires the
# operator-managed founder_program_settings row in the database to have
# program_enabled=true; capacity/expiry/versions live in that row, not here.
# Docs: docs/founder-program/14-launch-checklist.md.
PMFREAK_FOUNDER_PROGRAM_ENABLED=
PMFREAK_FOUNDER_PROGRAM_OPERATOR_UI_ENABLED=
PMFREAK_FOUNDER_PROGRAM_INVITATIONS_ENABLED=
PMFREAK_FOUNDER_PROGRAM_APPLICATIONS_ENABLED=
PMFREAK_FOUNDER_PROGRAM_ACTIVATION_ENABLED=
PMFREAK_FOUNDER_PROGRAM_FEEDBACK_ENABLED=
PMFREAK_FOUNDER_PROGRAM_ANALYTICS_ENABLED=

# ── Billing release control (server-only, optional) ───────────────────────────
# Paid checkout and the Stripe customer portal stay OFF unless this is exactly
# "true" — Stripe credentials alone never enable charging (fail-closed; see
# src/lib/billing-release.ts). Leave empty for the closed free beta.
PMFREAK_BILLING_CHECKOUT_ENABLED=

# ── Abuse protection (server-only, optional) ─────────────────────────────────
# Pepper used when hashing abuse-limit identifiers. Has a non-secret default;
# set a real value for stronger guarantees in production.
ABUSE_HASH_PEPPER=
